# Sanity (public — safe in browser / Netlify UI)
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=production
NEXT_PUBLIC_SANITY_API_VERSION=2025-01-01

# Google Analytics 4 measurement ID (public)
NEXT_PUBLIC_GA_MEASUREMENT_ID=G-Z4F8DL7KLQ

# Local-only escape hatch: bake site from config/*.ts seeds (no Sanity project yet)
# USE_FS_CONTENT=1

# Write / API token — NEVER commit, NEVER put on Netlify.
# Create in Sanity Manage → API → Tokens (Editor or Admin).
# Used for optional authenticated local fetches (fresher than CDN while authoring).
# SANITY_API_WRITE_TOKEN=
