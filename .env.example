# Sanity (public — safe in browser / Netlify UI)
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=production
NEXT_PUBLIC_SANITY_API_VERSION=2025-01-01

# Local-only escape hatch: bake site from config/*.ts seeds (no Sanity project yet)
# USE_FS_CONTENT=1

# Write / API token — NEVER commit, NEVER put on Netlify.
# Create in Sanity Manage → API → Tokens (Editor or Admin).
# Used by local seed/migrate scripts and optional authenticated fetches.
# SANITY_API_WRITE_TOKEN=
