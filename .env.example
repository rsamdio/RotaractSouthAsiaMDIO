# Sanity (public — safe in browser / Netlify UI)
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=production
NEXT_PUBLIC_SANITY_API_VERSION=2025-01-01

# Local-only escape hatch: bake site from config/*.ts seeds (no Sanity project yet)
# USE_FS_CONTENT=1

# Write token — NEVER put on Netlify. Local migrate/seed scripts only.
# SANITY_API_WRITE_TOKEN=
